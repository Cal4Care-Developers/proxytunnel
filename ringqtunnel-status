#!/bin/bash
# =============================================================================
# ringq-status -- RingQ Tunnel Status Check
# Install: cp ringq-status.sh /usr/local/bin/ringq-status && chmod +x /usr/local/bin/ringq-status
# Usage  : ringq-status
#          ringq-status --json       (machine-readable output)
#          ringq-status --watch      (refresh every 5s)
# =============================================================================

CONFIG_FILE="/root/ringqproxy/sip-proxy.yaml"
VERSION_FILE="/root/ringqproxy/version.txt"
SERVICE_NAME="ringqproxy"

# -- Flags --------------------------------------------------------------------
OPT_JSON=false
OPT_WATCH=false
for arg in "$@"; do
    case "$arg" in
        --json)  OPT_JSON=true ;;
        --watch) OPT_WATCH=true ;;
        --help)
            echo "Usage: ringq-status [--json] [--watch]"
            echo "  --json   Machine-readable JSON output"
            echo "  --watch  Refresh every 5 seconds (Ctrl+C to exit)"
            exit 0 ;;
        *) echo "Unknown flag: $arg  (use --help)"; exit 1 ;;
    esac
done

# -- Colours ------------------------------------------------------------------
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; DIM='\033[2m'; NC='\033[0m'
$OPT_JSON && { RED=''; GREEN=''; YELLOW=''; CYAN=''; BOLD=''; DIM=''; NC=''; }

# -- Read YAML helper (URL-safe: anchors to key name, preserves colons) -------
read_yaml() {
    local key="$1" file="$2"
    grep -m1 "^[[:space:]]*${key}:" "${file}" 2>/dev/null | \
        sed "s/^[[:space:]]*${key}:[[:space:]]*//" | \
        tr -d $'\r"\'' || echo ""
}

# =============================================================================
# Gather all data
# =============================================================================

# -- Config -------------------------------------------------------------------
if [[ ! -f "$CONFIG_FILE" ]]; then
    echo -e "${RED}ERROR:${NC} Config not found: $CONFIG_FILE"
    echo "  Is RingQ proxy installed? Run: install.sh"
    exit 1
fi

PBX_DOMAIN=$(read_yaml "pbx-domain"  "$CONFIG_FILE")
AUTH_KEY=$(read_yaml   "auth-key"    "$CONFIG_FILE")
DEVICE_ID=$(read_yaml  "device-id"   "$CONFIG_FILE")
PBX_API_URL=$(read_yaml "pbx-api-url" "$CONFIG_FILE")
# Device IP -- detect from network interface (same method as installer).
# Falls back to admin addr in YAML if interface detection fails.
DEVICE_IP=$(ip -4 addr show scope global 2>/dev/null | \
    grep -oP '(?<=inet\s)\d+(\.\d+){3}' | \
    grep -Ev '^(127\.|172\.(1[6-9]|2[0-9]|3[01])\.)' | \
    head -1 || echo "")
if [[ -z "$DEVICE_IP" ]]; then
    DEVICE_IP=$(grep -m1 'addr:' "$CONFIG_FILE" 2>/dev/null | \
        grep -oP '\d+\.\d+\.\d+\.\d+' || echo "")
fi
LAN_IP="$DEVICE_IP"   # keep internal var for JSON compat
PUBLIC_IP=$(grep -m1 'via: "udp://' "$CONFIG_FILE" 2>/dev/null | \
    sed 's|.*udp://||;s|:.*||;s|"||g' || echo "")
TUNNEL_HOST=$(grep -m1 'address: "tcp://' "$CONFIG_FILE" 2>/dev/null | \
    sed 's|.*tcp://||;s|:.*||;s|".*||' || echo "")
TUNNEL_PORT=$(grep -m1 'address: "tcp://' "$CONFIG_FILE" 2>/dev/null | \
    grep -oP ':\d+"' | tr -d ':"' || echo "6010")

# -- Service status -----------------------------------------------------------
if systemctl is-active --quiet "$SERVICE_NAME" 2>/dev/null; then
    SERVICE_STATUS="running"
    SERVICE_UPTIME=$(systemctl show "$SERVICE_NAME" --property=ActiveEnterTimestamp \
        --value 2>/dev/null | xargs -I{} bash -c \
        'echo $(( ($(date +%s) - $(date -d "{}" +%s 2>/dev/null || echo $(date +%s))) ))s' \
        2>/dev/null || echo "")
    # Convert seconds to human-readable
    if [[ -n "$SERVICE_UPTIME" && "$SERVICE_UPTIME" =~ ^[0-9]+s$ ]]; then
        SECS=${SERVICE_UPTIME%s}
        if (( SECS >= 86400 )); then
            SERVICE_UPTIME="$((SECS/86400))d $((SECS%86400/3600))h"
        elif (( SECS >= 3600 )); then
            SERVICE_UPTIME="$((SECS/3600))h $((SECS%3600/60))m"
        elif (( SECS >= 60 )); then
            SERVICE_UPTIME="$((SECS/60))m $((SECS%60))s"
        else
            SERVICE_UPTIME="${SECS}s"
        fi
    fi
else
    SERVICE_STATUS="stopped"
    SERVICE_UPTIME=""
fi

# -- Live tunnel auth check (POST to PBX heartbeat endpoint) ------------------
# This is the most reliable check: same call the proxy makes every 60s.
# 200 = auth key valid and active   → ACTIVE
# 401 = auth key revoked/deleted    → INACTIVE
# 403 = device_id mismatch          → INACTIVE
# other/error = PBX unreachable     → UNKNOWN
TUNNEL_STATUS="unknown"
TUNNEL_HTTP_CODE=""
if [[ -n "$PBX_API_URL" && -n "$AUTH_KEY" && -n "$DEVICE_ID" ]]; then
    HB_URL="${PBX_API_URL}/tunnel/heartbeat"
    HB_BODY="{\"auth_key\":\"${AUTH_KEY}\",\"device_id\":\"${DEVICE_ID}\"}"
    TUNNEL_HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" \
        --connect-timeout 5 --max-time 8 \
        -X POST "$HB_URL" \
        -H "Content-Type: application/json" \
        -d "$HB_BODY" 2>/dev/null || echo "000")
    case "$TUNNEL_HTTP_CODE" in
        200) TUNNEL_STATUS="active" ;;
        401) TUNNEL_STATUS="inactive" ;;
        403) TUNNEL_STATUS="inactive" ;;
        000) TUNNEL_STATUS="pbx_unreachable" ;;
        *)   TUNNEL_STATUS="unknown" ;;
    esac
fi

# -- Last activity from logs (OPTIONS keepalive = tunnel is alive) ------------
# "Proxy responding 200 OK to OPTIONS" fires every ~15-30s when registered.
# It's the best proxy for "last time PBX confirmed tunnel is reachable".
LAST_ACTIVE_RAW=$(journalctl -u "$SERVICE_NAME" --no-pager -n 100 2>/dev/null | \
    grep "Proxy responding 200 OK to OPTIONS" | tail -1 | \
    awk '{print $1, $2, $3}' || echo "")

# Also grab last bind result from logs
LAST_BIND_MSG=$(journalctl -u "$SERVICE_NAME" --no-pager -n 200 2>/dev/null | \
    grep -E "bind successful|bind rejected|Heartbeat: auth rejected|tunnel restored" | \
    tail -1 | sed 's/.*INFO[[:space:]]*//' | sed 's/.*ERROR[[:space:]]*//' \
    | sed 's/.*WARN[[:space:]]*//' || echo "")

# -- Version ------------------------------------------------------------------
VERSION=$(cat "$VERSION_FILE" 2>/dev/null || echo "unknown")

# -- Current public IP (live) -------------------------------------------------
CURRENT_PUBLIC_IP=$(curl -s --connect-timeout 5 --max-time 8 \
    https://api.ipify.org 2>/dev/null || echo "${PUBLIC_IP}")

# =============================================================================
# JSON output
# =============================================================================
if $OPT_JSON; then
    cat << JSONEOF
{
  "service": "${SERVICE_STATUS}",
  "tunnel_status": "${TUNNEL_STATUS}",
  "tunnel_http_code": "${TUNNEL_HTTP_CODE}",
  "pbx_domain": "${PBX_DOMAIN}",
  "pbx_api_url": "${PBX_API_URL}",
  "tunnel_endpoint": "tcp://${TUNNEL_HOST}:${TUNNEL_PORT}",
  "lan_ip": "${LAN_IP}",
  "public_ip": "${CURRENT_PUBLIC_IP}",
  "device_id": "${DEVICE_ID}",
  "auth_key_prefix": "${AUTH_KEY:0:8}",
  "version": "${VERSION}",
  "uptime": "${SERVICE_UPTIME}",
  "last_active": "${LAST_ACTIVE_RAW}"
}
JSONEOF
    exit 0
fi

# =============================================================================
# Human-readable output
# =============================================================================
do_status() {
    clear 2>/dev/null || true
    echo ""
    echo -e "${BOLD}${CYAN}  ╔══════════════════════════════════════════════╗${NC}"
    echo -e "${BOLD}${CYAN}  ║       RingQ Tunnel Status                   ║${NC}"
    echo -e "${BOLD}${CYAN}  ╚══════════════════════════════════════════════╝${NC}"
    echo ""

    # Service line
    if [[ "$SERVICE_STATUS" == "running" ]]; then
        SVC_ICON="${GREEN}●${NC}"
        SVC_LABEL="${GREEN}RUNNING${NC}"
        [[ -n "$SERVICE_UPTIME" ]] && SVC_LABEL+="${DIM}  (up ${SERVICE_UPTIME})${NC}"
    else
        SVC_ICON="${RED}●${NC}"
        SVC_LABEL="${RED}STOPPED${NC}"
    fi
    echo -e "  Service      :  ${SVC_ICON} ${SVC_LABEL}"

    # Tunnel auth line
    case "$TUNNEL_STATUS" in
        active)
            echo -e "  Tunnel Auth  :  ${GREEN}✓ ACTIVE${NC}${DIM}  (auth key valid)${NC}"
            ;;
        inactive)
            echo -e "  Tunnel Auth  :  ${RED}✗ INACTIVE${NC}${DIM}  (auth key revoked — HTTP ${TUNNEL_HTTP_CODE})${NC}"
            ;;
        pbx_unreachable)
            echo -e "  Tunnel Auth  :  ${YELLOW}⚠ PBX UNREACHABLE${NC}${DIM}  (cannot reach ${PBX_API_URL})${NC}"
            ;;
        *)
            echo -e "  Tunnel Auth  :  ${YELLOW}? UNKNOWN${NC}${DIM}  (HTTP ${TUNNEL_HTTP_CODE})${NC}"
            ;;
    esac

    echo ""
    echo -e "  ${BOLD}Connection${NC}"
    echo -e "  PBX Domain   :  ${YELLOW}${PBX_DOMAIN}${NC}"
    echo -e "  PBX Tunnel   :  ${YELLOW}tcp://${TUNNEL_HOST}:${TUNNEL_PORT}${NC}"
    echo -e "  PBX API      :  ${YELLOW}${PBX_API_URL}${NC}"
    echo ""
    echo -e "  ${BOLD}This Device${NC}"
    echo -e "  Device IP    :  ${YELLOW}${DEVICE_IP}${NC}"
    echo -e "  Public IP    :  ${YELLOW}${CURRENT_PUBLIC_IP}${NC}"
    echo -e "  Device ID    :  ${YELLOW}${DEVICE_ID}${NC}"
    echo -e "  Auth Key     :  ${YELLOW}${AUTH_KEY:0:8}...${AUTH_KEY: -4}${NC}"
    echo ""
    echo -e "  ${BOLD}Info${NC}"
    echo -e "  Version      :  ${YELLOW}${VERSION}${NC}"
    [[ -n "$LAST_ACTIVE_RAW" ]] && \
    echo -e "  Last Active  :  ${YELLOW}${LAST_ACTIVE_RAW}${NC}${DIM}  (last OPTIONS keepalive from PBX)${NC}"
    [[ -n "$LAST_BIND_MSG" ]] && \
    echo -e "  Last Event   :  ${DIM}${LAST_BIND_MSG:0:72}${NC}"
    echo ""

    # Bottom hint
    echo -e "  ${DIM}Logs:   journalctl -u ${SERVICE_NAME} -f${NC}"
    echo -e "  ${DIM}Config: ${CONFIG_FILE}${NC}"
    $OPT_WATCH && echo -e "  ${DIM}Refreshing every 5s — Ctrl+C to exit${NC}"
    echo ""
}

# -- Watch mode ---------------------------------------------------------------
if $OPT_WATCH; then
    while true; do
        do_status
        sleep 5
        # Re-collect data on next loop
        if systemctl is-active --quiet "$SERVICE_NAME" 2>/dev/null; then
            SERVICE_STATUS="running"
        else
            SERVICE_STATUS="stopped"
        fi
        TUNNEL_HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" \
            --connect-timeout 5 --max-time 8 \
            -X POST "${PBX_API_URL}/tunnel/heartbeat" \
            -H "Content-Type: application/json" \
            -d "$HB_BODY" 2>/dev/null || echo "000")
        case "$TUNNEL_HTTP_CODE" in
            200) TUNNEL_STATUS="active" ;;
            401|403) TUNNEL_STATUS="inactive" ;;
            000) TUNNEL_STATUS="pbx_unreachable" ;;
            *) TUNNEL_STATUS="unknown" ;;
        esac
        LAST_ACTIVE_RAW=$(journalctl -u "$SERVICE_NAME" --no-pager -n 50 2>/dev/null | \
            grep "Proxy responding 200 OK to OPTIONS" | tail -1 | \
            awk '{print $1, $2, $3}' || echo "")
    done
else
    do_status
fi
